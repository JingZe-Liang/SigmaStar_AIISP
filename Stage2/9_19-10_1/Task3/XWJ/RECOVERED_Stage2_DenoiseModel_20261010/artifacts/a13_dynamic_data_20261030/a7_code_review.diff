+def _resolve_capture_path(dataset_root: Path, clip: CaptureClip) -> Path:
+    if Path(clip.path).is_absolute():
+        raise ValueError(f"{clip.clip_id}: RAW path must be relative to dataset root")
+    root = dataset_root.resolve()
+    path = (root / clip.path).resolve()
+    try:
+        path.relative_to(root)
+    except ValueError as error:
+        raise ValueError(f"{clip.clip_id}: path escapes dataset root: {clip.path}") from error
+    if not path.is_file():
+        raise FileNotFoundError(f"{clip.clip_id}: missing RAW file {path}")
+    return path
